[Unit]
Description=ZenOS Telegram Bot
After=network.target zenos-api.service
Wants=zenos-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zenos
EnvironmentFile=/opt/zenos/.env
ExecStart=/opt/zenos/.venv/bin/python -m zenos.telegram.bot
Restart=always
RestartSec=10
StandardOutput=append:/var/log/zenos-tg-bot.log
StandardError=append:/var/log/zenos-tg-bot.log

[Install]
WantedBy=multi-user.target
