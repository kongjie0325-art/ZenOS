{
  "name": "zenos",
  "version": "0.1.0",
  "description": "ZenOS - AI Operating System",
  "author": "ZenOS Team",
  "license": "MIT",
  "python_requires": ">=3.10",
  "dependencies": {
    "pyyaml": ">=6.0",
    "aiohttp": ">=3.9",
    "redis": ">=5.0",
    "qdrant-client": ">=1.7"
  },
  "devDependencies": {
    "pytest": ">=7.0",
    "pytest-asyncio": ">=0.23",
    "pytest-cov": ">=4.0",
    "mypy": ">=1.0",
    "ruff": ">=0.1"
  },
  "scripts": {
    "test": "pytest tests/ -v --tb=short",
    "test:coverage": "pytest tests/ --cov=zenos --cov-report=term-missing",
    "lint": "ruff check .",
    "typecheck": "mypy zenos/",
    "run": "python -m zenos"
  }
}
